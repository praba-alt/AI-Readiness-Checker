# Brand visibility provider keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_API_KEY=

# Brand visibility provider defaults
# Use OpenRouter-backed small models by default to keep costs down.
VISIBILITY_PROVIDERS=openai_or
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_OPENAI_MODEL=openai/gpt-4.1-mini
OPENROUTER_CLAUDE_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SONAR_MODEL=perplexity/sonar
CLAUDE_API_MODEL=claude-haiku-4-5-20251001
CLAUDE_API_MAX_TOKENS=300
CLAUDE_API_MIN_INTERVAL_MS=13000
OPENAI_MIN_INTERVAL_MS=2500

# Mention-analysis settings
ANALYSIS_PROVIDER=openai
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:7b

# Shopify Admin API credentials
SHOPIFY_ADMIN_DOMAIN_TRAILBERG=
SHOPIFY_ADMIN_TOKEN_TRAILBERG=
SHOPIFY_ADMIN_DOMAIN_LORENZO=
SHOPIFY_ADMIN_TOKEN_LORENZO=
SHOPIFY_ADMIN_DOMAIN_DREAM_IS_FREE=
SHOPIFY_ADMIN_TOKEN_DREAM_IS_FREE=

# Optional explicit Shopify storefront MCP domains.
# Only set these if the myshopify shop domain differs from the admin store handle.
SHOPIFY_STOREFRONT_MCP_DOMAIN_TRAILBERG=
SHOPIFY_STOREFRONT_MCP_DOMAIN_LORENZO=
SHOPIFY_STOREFRONT_MCP_DOMAIN_DREAM_IS_FREE=

# Optional browser-session helpers for manual Shopify Admin login
SHOPIFY_ADMIN_PROFILE_DIR=tmp/browser-profiles/shopify-admin
PUPPETEER_BROWSER_CHANNEL=chrome
PUPPETEER_EXECUTABLE_PATH=
