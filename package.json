{
  "name": "ai-readiness-checker",
  "private": true,
  "scripts": {
    "generate:visibility": "node scripts/generate_brand_visibility_report.mjs",
    "audit:storefront": "node scripts/shopify_storefront_audit.js --config configs/audit_config.json --output output/data/shopify_storefront_audit.json",
    "audit:admin": "node scripts/shopify_admin_audit.js --config configs/audit_config.json --output output/data/shopify_admin_audit.json",
    "admin:session": "node scripts/shopify_admin_browser_session.mjs",
    "report:workbook": "python3 scripts/generate_master_template_workbook.py --template output/spreadsheet/AI_Analysis_Report_Master_Template_2026-03-30.xlsx --visibility-report output/spreadsheet/AI_Brand_Visibility_Report_2026-03-26.xlsx --audit-json output/data/shopify_storefront_audit.json --admin-audit-json output/data/shopify_admin_audit.json --output output/spreadsheet/AI_Analysis_Report_Master_Template_2026-03-30.xlsx",
    "report:action-plan-md": "python3 scripts/generate_ai_readiness_action_plan.py --storefront-audit output/data/shopify_storefront_audit.json --admin-audit output/data/shopify_admin_audit.json --visibility-report output/spreadsheet/AI_Brand_Visibility_Report_2026-03-26.xlsx --config configs/audit_config.json --output output/docs/ai_readiness_action_plan.md",
    "report:action-plan-docx": "python3 scripts/generate_ai_readiness_action_plan_docx.py --storefront-audit output/data/shopify_storefront_audit.json --admin-audit output/data/shopify_admin_audit.json --visibility-report output/spreadsheet/AI_Brand_Visibility_Report_2026-03-26.xlsx --config configs/audit_config.json --template-docx output/doc/ai_readiness_action_plan_2026-03-30.docx --output output/doc/ai_readiness_action_plan.docx",
    "run:pipeline": "bash scripts/run_pipeline.sh"
  },
  "dependencies": {
    "ai-brand-visibility-checker": "git+https://github.com/praba-alt/brand-rank-check-in-ai-chat.git",
    "puppeteer": "^24.6.0",
    "xlsx": "^0.18.5"
  }
}
